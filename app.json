{
  "expo": {
    "name": "TennisStats",
    "slug": "tennis-stats",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tennisstats.app"
    },
    "android": {
      "package": "com.tennisstats.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-sqlite"]
  }
}
